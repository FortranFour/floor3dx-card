{
  "name": "floor3dx-card",
  "version": "2.15.0",
  "description": "Floor3DX Card: a fork of floor3dpro-card (itself based on floor3d-card) with compressed-model support, full-resolution rendering and a fix for the shared-geometry door bug",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards"
  ],
  "module": "floor3dx-card.js",
  "repository": "https://github.com/FortranFour/floor3dx-card",
  "author": "FortranFour",
  "license": "MIT",
  "dependencies": {
    "@lit-labs/scoped-registry-mixin": "^1.0.4",
    "@material/mwc-button": "^0.25.3",
    "@material/mwc-formfield": "^0.25.3",
    "@material/mwc-icon": "^0.25.3",
    "@material/mwc-icon-button": "^0.25.3",
    "@material/mwc-list": "^0.25.3",
    "@material/mwc-menu": "^0.25.3",
    "@material/mwc-notched-outline": "^0.25.3",
    "@material/mwc-ripple": "^0.25.3",
    "@material/mwc-select": "^0.25.3",
    "@material/mwc-switch": "^0.25.3",
    "@material/mwc-textfield": "^0.25.3",
    "@mdi/font": "^6.5.95",
    "@mdi/js": "^7.4.47",
    "@tweenjs/tween.js": "^18.6.4",
    "custom-card-helpers": "^1.7.2",
    "gifuct-js": "^2.1.2",
    "home-assistant-js-websocket": "^5.11.1",
    "lit": "^3.3.3",
    "three": "^0.186.1",
    "three-spritetext": "^1.6.4",
    "tslib": "2.6.2"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "node build.mjs --watch",
    "build": "npm run lint && npm run bundle",
    "lint": "eslint src/*.ts",
    "bundle": "node build.mjs && node scripts/copy-decoders.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/unit-tests.mjs"
  },
  "overrides": {
    "tslib": "2.6.2"
  },
  "contributors": [
    "Levent ERDEM (levonisyas) - floor3dpro-card",
    "Andrea Di Zanni (adizanni) - floor3d-card"
  ]
}
